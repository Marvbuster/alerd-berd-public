# --- Datenbank -------------------------------------------------------------
# Postgres-Verbindung.
# Lokal: docker compose up db  →  Port 5436 (extern; 5433–5435/5439 sind belegt)
# Coolify: Service-URL der Postgres-Resource, z. B.
#          postgres://user:pass@alerd-board-db:5432/alerdboard
DATABASE_URL="postgresql://alerdboard:alerdboard@localhost:5436/alerdboard"

# --- Alerting: Web Push (VAPID) -------------------------------------------
# Für Handy-Push ohne native App (installierte PWA / Browser). Schlüsselpaar
# einmalig erzeugen: `npx web-push generate-vapid-keys`.
# Der PUBLIC-Key geht auch an den Client; PRIVATE-Key ist ein Secret.
# Noch nicht verdrahtet (Roadmap 0.3) — Keys hier vorbereiten.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:alerts@example.com"

# --- Alerting: E-Mail -----------------------------------------------------
# Bevorzugt Brevo (Transactional API). Wenn BREVO_API_KEY
# gesetzt ist, wird Brevo genutzt; sonst SMTP; sonst Dry-Run (nur Log).
BREVO_API_KEY=""
ALERT_FROM="Alerd Board <alerts@example.com>"
# Fallback SMTP (nur falls kein Brevo):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Scheduler ------------------------------------------------------------
# Gemeinsames Secret, mit dem der Check-Runner (Cron/Coolify-Scheduled-Task)
# den internen Endpoint /api/run-checks aufruft. Noch nicht verdrahtet (0.2).
RUN_CHECKS_SECRET=""

# --- Coolify-Inventar (optional, nur lesend) -------------------------------
# 32 Byte als 64 Hex-Zeichen, z. B. openssl rand -hex 32. Dauerhaft sichern.
# Separater Schlüssel, NICHT AUTH_SECRET verwenden oder bei Redeploy neu erzeugen.
CREDENTIAL_ENCRYPTION_KEY=""
# Explizit erlaubte Origins, kommagetrennt, ohne Slash/Pfad.
# Beispiel: https://coolify.example.com (intern optional http://coolify:8080)
COOLIFY_ALLOWED_ORIGINS=""

# --- Zugangsschutz (Multi-User, Accounts) ---
# Signatur-Secret fürs Session-JWT (jose, HS256). MINDESTENS 32 Zeichen, sonst
# Hard-Fail. Erzeugen z. B.: `openssl rand -base64 48`. Leer = Dev-Modus (Proxy
# lässt alles durch, damit man sich lokal nicht aussperrt).
AUTH_SECRET=""
# Admin-Seed: wird beim Container-Start angelegt/aktualisiert (scripts/seed-admin.mjs)
# und bekommt alle vor der Umstellung angelegten Monitore/Kanäle (Owner-Backfill).
# Das Passwort ist über diese Env steuerbar (es gibt noch keine In-App-Änderung).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# DEPRECATED (altes Single-User-/VPN-Modell): APP_ACCESS_SECRET und
# ALLOW_PUBLIC_READ werden nicht mehr verwendet — Zugang läuft über Accounts.

# --- Health-Contract: Spec-Zugang (Bearer) ---
# Die Guides unter /spec/* (Schema, Beispiel, Implementierungs-Guide) sind NICHT
# offen, sondern token-geschützt (Muster wie der AI Proxy: llms.txt ist offen und
# zeigt dorthin, die Guides selbst liegen hinter dem Token). Der NORMALE Weg ist
# ein persönlicher API-Key, den sich jeder User selbst unter /keys anlegt
# (`Authorization: Bearer alrd_…`, pro User widerrufbar); eine eingeloggte Session
# reicht ebenfalls (Browser). SPEC_ACCESS_TOKEN ist nur noch ein optionaler
# globaler Fallback/Legacy-Token. Leer lassen = Zugang nur über API-Key/Session.
SPEC_ACCESS_TOKEN=""

# --- Eigene Spec-Health (/api/spec-health) --------------------------------
# Bearer für Alerds eigenen Deep-Check. Derselbe Wert gehört in den Monitor
# „Token der App“, wenn Alerd Board sich als Dienst selbst beobachtet.
# Erzeugen: `openssl rand -hex 32`. Leer = Route antwortet 503.
SPEC_HEALTH_TOKEN=""
